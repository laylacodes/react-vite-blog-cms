# ---------------------------------------------------------------------------
# Frontend environment variables
# ---------------------------------------------------------------------------
# Copy this file to ".env" in your project root and fill in the values.
# Vite only exposes variables prefixed with VITE_ to the browser, so it is safe
# for these two to ship in your client bundle (the anon key is meant to be public).

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Your Supabase project's anon / publishable key
# (Supabase dashboard → Project Settings → API → "anon public" / "Publishable key")
VITE_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# Backend secrets — DO NOT put these in .env or commit them.
# ---------------------------------------------------------------------------
# These belong to the Supabase Edge Functions and must be set with the CLI:
#
#   supabase secrets set ADMIN_SECRET="a-long-random-password-min-16-chars"
#   supabase secrets set GITHUB_TOKEN="ghp_your_personal_access_token"
#   supabase secrets set GITHUB_REPO="your-github-username/your-repo-name"
#
# Optional:
#   supabase secrets set GITHUB_BRANCH="main"                 # defaults to "main"
#   supabase secrets set ALLOWED_ORIGIN="https://example.com" # defaults to "*"
#
#   ADMIN_SECRET    Password you type to log in to the studio. Min 16 characters.
#   GITHUB_TOKEN    GitHub PAT with "repo" (contents: read & write) access.
#   GITHUB_REPO     The repo posts are committed to, as "owner/name".
#   GITHUB_BRANCH   Branch to commit to. Defaults to "main".
#   ALLOWED_ORIGIN  Comma-separated site origins allowed to call the functions.
#                   Leave as "*" for local dev; set to your domain in production.
